// app/api/shipping/rates/route.ts
import { NextResponse } from 'next/server';
import { getLiveShippingOptions } from '@/lib/shipping-live';

// ensure no caching for dynamic quotes
export const revalidate = 0;
// (optional) force node runtime:
// export const runtime = 'nodejs';

export async function POST(req: Request) {
  try {
    const body = await req.json();
    if (!body?.originZip || !body?.destCountry || !body?.destPostal) {
      return NextResponse.json({ error: 'missing_fields' }, { status: 400 });
    }
    const options = await getLiveShippingOptions(body);
    return NextResponse.json({ shippingOptions: options }, { status: 200 });
  } catch (e: any) {
    return NextResponse.json({ error: e?.message || 'rate_error' }, { status: 500 });
  }
}
